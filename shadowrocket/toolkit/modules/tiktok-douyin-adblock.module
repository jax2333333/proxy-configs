#!name=JAX - TikTok / 抖音广告净化
#!desc=TikTok 安全优先：拦截高置信度字节广告域名与明确 /api/ad/ 请求，并递归过滤抖音 amemv / aweme.snssdk.com JSON 中具有强广告标记的 Feed / 短剧插播广告。v5 · 2026-09-06

# 设计原则：
# - TikTok 安全 / 地区稳定优先，不阻断 tiktokv.com / tiktokcdn.com / byteoversea 等核心域名。
# - 不封整个 snssdk.com / zijieapi.com / pstatp.com，避免共享基础设施误伤 TikTok 或抖音正常业务。
# - 域名层仅拦截公开规则库明确标记为 Ads/Tracking 的高置信度广告专用域名。
# - 明确 /api/ad/ 路径直接拒绝；原生信息流与短剧插播广告继续由自托管 response Script 处理。
# - ad_info / adInfo 不能单独判定为广告；普通作品可能携带通用广告能力/配置字段。
# - 脚本不主动联网、不上传 Cookie/Header/账号信息；解析异常时原样放行。

[Rule]

# ============================================================
# 抖音 / 字节：高置信度广告与推广平台
# ============================================================

# 今日头条 / 字节广告入口
DOMAIN,ad.toutiao.com,REJECT
DOMAIN,dig.bdurl.net,REJECT
DOMAIN-SUFFIX,byteadverts.com,REJECT
DOMAIN-SUFFIX,csjplatform.com,REJECT
DOMAIN-SUFFIX,shoppingads.cn,REJECT

# Pangle / 穿山甲中国广告平台
DOMAIN-SUFFIX,pangle.cn,REJECT
DOMAIN-SUFFIX,pangolin-dsp-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-dsp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,panplayable-toutiao-b.com,REJECT
DOMAIN-SUFFIX,panplayable-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-snssdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT

# snssdk.com 为 TikTok / 抖音共享基础设施，禁止整域封锁；仅拒绝明确广告子域
DOMAIN,pangolin-hl.snssdk.com,REJECT
DOMAIN,pangolin-lf.snssdk.com,REJECT
DOMAIN,pangolin-lq.snssdk.com,REJECT
DOMAIN,pangolin.snssdk.com,REJECT

# ============================================================
# 明确广告 API
# ============================================================
# GitHub 多个长期方案均直接拒绝 /api/ad/；这里仅限当前已纳入 MITM 的抖音主机，
# 不新增 zlink.ugsdk.cn、不新增其它字节共享主机，避免扩大回归面。

[URL Rewrite]
^https:\/\/(?:[^\/]+\.amemv\.com|aweme\.snssdk\.com)\/api\/ad\/ - reject

# ============================================================
# 抖音原生 Feed / 短剧广告
# ============================================================
# 2026-09-06 实测日志结论：
# - 广告视频与普通视频一样可使用 douyinvod.com / dyseries.douyinvod.com，不能直接 REJECT 视频 CDN。
# - 333333.db 捕获 api.amemv.com 后紧接短剧视频连接。
# - 3(1).db 捕获 aweme.snssdk.com 后约 2 秒即出现 v96-dyseries.douyinvod.com。
# - v5 继续保留 *.amemv.com + 精确 aweme.snssdk.com；不扩大到 *.snssdk.com / *.zijieapi.com。
# - 脚本移除 ad_info/adInfo 的单独强标记资格，新增 aweme_raw_ad/awemeRawAd，降低普通作品误删风险。
# - is_ads/is_ad 同时接受布尔、数字与字符串真值；仅删除具有强广告证据的内容对象。

[Script]
# 仅处理当前明确抖音 API；JSON、体积、深度和节点数量均有限制，失败即原样放行。
# 日志仅记录 host + path + removed 数量，不记录 query / Cookie / Token。
douyin_feed_adblock = type=http-response,pattern=^https://(?:[^/]+\.amemv\.com|aweme\.snssdk\.com)/,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/jax2333333/proxy-configs/main/shadowrocket/toolkit/scripts/douyin-feed-adblock.js?v=20260906-5

# ============================================================
# 保守排除（故意不拦截 / 不整域 MITM）
# ============================================================
# bds.snssdk.com / extlog.snssdk.com / i.snssdk.com / mcs.snssdk.com
# ecomuser.snssdk.com / 其它 *.snssdk.com
# log.zijieapi.com / ctobsnssdk.com / sf3-ttcdn-tos.pstatp.com
# zlink.ugsdk.cn / 未经本机日志验证的 6443 IP / NCDN 规则
# 这些主机或规则属于共享、遥测或其它方案的特定环境；为保证 TikTok 安全与 App 稳定不照搬。

[MITM]
# amemv 暂保留 wildcard 以覆盖本机实测 api.amemv.com；未来收集足够完整 URL 后再收窄为具体主机白名单。
# snssdk 只保留实测出现的 aweme.snssdk.com，禁止 *.snssdk.com。
hostname = %APPEND% *.amemv.com, aweme.snssdk.com
