#!name=JAX - 网站净化中心
#!desc=JAX 统一网页净化模块：51cg1.com、wnacg.com 使用网页净化；missav.ws 暂改网络级净化，避免 Cloudflare 验证与 MITM 冲突。2026-08-31

# ============================================================
# JAX Site Cleaner
#
# 设计原则：
# 1. 一个 Shadowrocket 模块集中管理所有网站净化。
# 2. 不使用 hostname = *。
# 3. 只 MITM 明确且兼容网页改写的网站。
# 4. JS 完全托管在自己的 GitHub。
# 5. 不上传 Cookie / Header / 账号信息 / 浏览记录。
# 6. Cloudflare 验证与 MITM 冲突的网站优先采用网络级净化。
#
# 手机端始终只需要保留并更新这一个模块。
# ============================================================

[Rule]

# 51CG1：阻止 QUIC / HTTP3，使 HTTPS 回落 TCP，方便 MITM 网页正文
AND,((DOMAIN,51cg1.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,www.51cg1.com),(PROTOCOL,UDP)),REJECT

# WNACG：阻止 QUIC / HTTP3，使 HTTPS 回落 TCP，方便 MITM 网页正文
AND,((DOMAIN,wnacg.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,www.wnacg.com),(PROTOCOL,UDP)),REJECT

# MissAV：暂时不 MITM 主站，改为网络级净化，避免 Cloudflare 安全验证循环。
# 已确认的第三方广告/推广/点击劫持域名。
DOMAIN,go.mayzaent.com,REJECT
DOMAIN,creative.live.missav.com,REJECT
DOMAIN,tsyndicate.com,REJECT
DOMAIN,cdn.tsyndicate.com,REJECT
DOMAIN,cm.pxltag.com,REJECT
DOMAIN,go.rmishe.com,REJECT
DOMAIN,stripchat.dk,REJECT
DOMAIN,myavlive.com,REJECT
DOMAIN-SUFFIX,ladyoffices.com,REJECT

[Script]

# 统一网页净化脚本
# missav.ws 暂不进入响应改写，避免影响 Cloudflare challenge。
JAX Site Cleaner = type=http-response,pattern=^https://(?:(?:www\.)?51cg1\.com|(?:www\.)?wnacg\.com)/.*,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/jax2333333/proxy-configs/main/shadowrocket/toolkit/scripts/site-cleaner.js?v=20260831-6,engine=jsc,timeout=10

[MITM]

# 最小 MITM 白名单。missav.ws 当前明确排除。
hostname = %APPEND% 51cg1.com,www.51cg1.com,wnacg.com,www.wnacg.com
